# Copy to .env and adjust values for your environment.
# The scripts auto-load .env from repository root unless DOVIFUSE_ENV_FILE is set.
# This file is sourced by bash, so variable expansion/command substitution is supported.

# Base paths
DOVIFUSE_BASE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
DOVIFUSE_SCRIPT_PATH="${DOVIFUSE_BASE_DIR}/DoviFuse.sh"

# Converter behavior
DOVIFUSE_EL_RPU_DIR=/NAS/EL_RPU
DOVIFUSE_PROCESSING_LOG_FILE="${DOVIFUSE_BASE_DIR}/processing_log.txt"
DOVIFUSE_CONVERTER_BIN=

# qBittorrent wrapper behavior
DOVIFUSE_TRIGGER_LOG_FILE="${DOVIFUSE_BASE_DIR}/qbt_trigger.log"
DOVIFUSE_TRIGGER_LOG_MAX_BYTES=10485760
# Retained queue location coordinates with older installations.
DOVIFUSE_RUN_DIR=/tmp/dv8-qbt
DOVIFUSE_AUTORUN_DRY_RUN=false
DOVIFUSE_MAX_PARALLEL_JOBS=1
DOVIFUSE_QUEUE_WAIT_SECONDS=15
DOVIFUSE_JOB_LOG_RETENTION_DAYS=30

# qBittorrent API and cleanup
DOVIFUSE_QBT_API_URL=http://127.0.0.1:8080
DOVIFUSE_QBT_REMOVE_CONVERTED=true

# Roots scanned to repoint hardlinks after conversion
DOVIFUSE_MEDIA_ROOTS=/path/to/media/root1:/path/to/media/root2

# Telegram notifications (sent when a file finishes processing)
DOVIFUSE_TELEGRAM_BOT_TOKEN=
DOVIFUSE_TELEGRAM_CHAT_ID=
DOVIFUSE_TELEGRAM_THREAD_ID=
